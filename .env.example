# Portfolio X-ray settings. Copy to .env (gitignored) and edit; every line is optional.
# docker compose reads .env automatically. Placeholder values only — put your own hosts here.

# ── Server ────────────────────────────────────────────────────────────────
HOST_PORT=8097                 # Port published on the Docker host (container listens on PORT)
PORT=8096                      # Port the Node server listens on inside the container
HOST=0.0.0.0                   # Bind address inside the container
NITRO_HOST=0.0.0.0             # Same, for the Nitro runtime
TZ=America/Toronto             # Time zone for schedules (price prefetch ~6 PM) and logs
# NITRO_PRESET=node-server       # Build preset (build time only; leave as is for Docker)

# ── Ollama (ETF breakdown → "Ask about this ETF") ────────────────────────
OLLAMA_URL=http://host.docker.internal:11434   # Your Ollama base URL, e.g. http://<your-lan-host>:11434. Unset = Q&A panel shows "not configured"
OLLAMA_MODEL=qwen3.5:9b        # Model name as listed by `ollama list`
OLLAMA_TIMEOUT_MS=120000       # Give up on an Ollama answer after this many ms

# ── Currency (the app reports everything in CAD) ─────────────────────────
FX_PAIR=USDCAD=X               # Yahoo FX symbol for the live USD→CAD rate (falls back to CAD=X)
FX_USDCAD_OVERRIDE=            # Optional manual CAD-per-USD rate, e.g. 1.37. When set it replaces the live rate and the UI labels it "manual"
FX_CACHE_FILE=/data/lookthru/fx-usdcad.json    # Last good live rate, used when Yahoo is unreachable

# ── Rebalance ─────────────────────────────────────────────────────────────
REBALANCE_THRESHOLD_PCT=10     # Default deviation band (%) in the Target & rebalance tab; users can still edit it in the UI

# ── Data files and caches (inside the portfolio-x-ray-data volume) ───────
LOOKTHRU_HOLDINGS_FILE=/data/lookthru/holdings.json        # Optional pre-scraped ETF holdings
LOOKTHRU_TICKERS_FILE=/data/lookthru/tickers.json          # Optional ticker list for Fund Lookup autocomplete
LOOKTHRU_PROVIDER_DIR=/data/lookthru/provider-holdings     # Brompton (BMAX etc.) holdings cache
INDEX_HOLDINGS_DIR=/data/lookthru/index-holdings           # Cached index constituents (IVV, XQQU, XIU…)
PRICES_DB_FILE=/data/lookthru/prices.sqlite                # Yahoo price-history cache for the total-return chart

# ── Background jobs and polite fetching ──────────────────────────────────
PRICES_PREFETCH=1              # 0 disables the price-history prefetch (startup + ~6 PM)
PROVIDER_HOLDINGS_PREFETCH=1   # 0 disables the background Brompton holdings fetch
PROVIDER_FETCH_DELAY_MS=10000  # Gap between bromptongroup.com requests; values below 10000 (their crawl delay) are ignored
PROVIDER_CACHE_TTL_HOURS=168   # How long a cached provider list counts as fresh
PROVIDER_REFRESH_HOURS=24      # How often the background job re-checks providers
VALUATION_REQUEST_GAP_MS=400   # Gap between Yahoo estimate requests for Forward P/E

# ── ETF notes script (npm run etf-notes) ─────────────────────────────────
SEARCH_URL=http://host.docker.internal:8099    # SearXNG base URL for optional web snippets
SEARCH_ENGINE=searxng          # Search backend name
SEARCH_DELAY_MS=400            # Gap between search requests (ms)
FETCH_PAGES=0                  # 1 = fetch each provider page into the prompt
ETF_NOTES_DIR=/data/lookthru   # Where etf-notes.md / etf-notes.json are written (LOOKTHRU_NOTES_DIR is an older alias)
ETF_NOTES_MD=                  # Optional explicit path for etf-notes.md
ETF_NOTES_JSON=                # Optional explicit path for etf-notes.json

# ── Optional app platform features (unused in the Docker setup; leave commented) ──
# DATABASE_URL=                  # Postgres URL for sign-in features; blank = disabled. Never commit a real one
# VITE_AUTH_ENABLED=false        # Build-time switch for the sign-in gate
# VITE_STUN_URLS=                # Comma-separated STUN servers for the multiplayer module
# BETTER_AUTH_SECRET=            # Session signing secret when sign-in is enabled (generate your own; never commit)
# BETTER_AUTH_URL=               # Public base URL used by sign-in callbacks
# GROK_PROJECT_ID=               # Set only by the hosted deployer; blank = local/preview mode
# GROK_AUTH_ISSUER=              # Hosted sign-in issuer (hosted deploys only)
# GROK_AUTH_CLIENT_ID=           # Hosted sign-in client id (hosted deploys only)
# GROK_AUTH_CLIENT_SECRET=       # Hosted sign-in client secret (hosted deploys only; never commit)
# GROK_CONNECTORS_URL=           # Hosted connector endpoint (hosted deploys only)
# GROK_CONNECTOR_ACCESS_TOKEN=   # Hosted connector token (hosted deploys only; never commit)

# ── Node runtime (already set in the Dockerfile; leave commented) ─────────
# NODE_ENV=production            # production in the container
# NODE_OPTIONS=--experimental-sqlite   # Needed for the SQLite price cache on Node 22
# Dev-only helpers also read PREVIEW_READY_TIMEOUT_MS, PREVIEW_THUMBNAIL_TIMEOUT_MS,
# BROWSER_SMOKE_TIMEOUT_MS, BROWSER_ALLOW_EXTERNAL_HOST, VITE_PUBLIC_HOSTNAME, VITE_PROJECT_ID,
# VITE_OG_SERVICE_URL, X_CREATOR and X_CREATOR_ID; none matter for Docker.
